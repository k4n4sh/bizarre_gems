[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/result.gd" id="1"]
[ext_resource type="Script" path="res://scripts/strike_replay.gd" id="2"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_video.png" id="3"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_shuffle.png" id="4"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_share.png" id="5"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_restart.png" id="6"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_trophy.png" id="7"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_home.png" id="8"]

[node name="Result" type="PanelContainer"]
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"Muted"
theme_override_font_sizes/font_size = 18
horizontal_alignment = 1

[node name="Score" type="Label" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"Number"
theme_override_font_sizes/font_size = 60
text = "0"
horizontal_alignment = 1

[node name="Badge" type="PanelContainer" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
size_flags_horizontal = 4

[node name="NewBest" type="Label" parent="VBox/Badge"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"Bold"
theme_override_colors/font_color = Color(0.95686, 0.92941, 0.85490, 1)
theme_override_font_sizes/font_size = 16
text = "new_best"
horizontal_alignment = 1

[node name="Stats" type="HBoxContainer" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
alignment = 1
theme_override_constants/separation = 24

[node name="Line" type="Label" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"Muted"
horizontal_alignment = 1
autowrap_mode = 3
size_flags_horizontal = 3

[node name="BestStrike" type="PanelContainer" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true

[node name="Row" type="HBoxContainer" parent="VBox/BestStrike"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Replay" type="Control" parent="VBox/BestStrike/Row"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(76, 76)
script = ExtResource("2")

[node name="Caption" type="Label" parent="VBox/BestStrike/Row"]
layout_mode = 2
unique_name_in_owner = true
size_flags_horizontal = 3
size_flags_vertical = 4
autowrap_mode = 3
theme_type_variation = &"Bold"
theme_override_colors/font_color = Color(0.6667, 0.7216, 0.9255, 1)
theme_override_font_sizes/font_size = 15

[node name="RewardRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
theme_override_constants/separation = 12

[node name="Reward" type="Label" parent="VBox/RewardRow"]
layout_mode = 2
unique_name_in_owner = true
size_flags_horizontal = 3
size_flags_vertical = 4
theme_type_variation = &"Bold"
theme_override_colors/font_color = Color(0.498, 0.8471, 1, 1)

[node name="Double" type="Button" parent="VBox/RewardRow"]
layout_mode = 2
unique_name_in_owner = true
icon = ExtResource("3")

[node name="Continue" type="Button" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
text = "continue_ad"
icon = ExtResource("3")

[node name="Shuffle" type="Button" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
text = "shuffle_ad"
icon = ExtResource("4")

[node name="Again" type="Button" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"PrimaryButton"
text = "again"
icon = ExtResource("6")

[node name="Buttons" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Leaders" type="Button" parent="VBox/Buttons"]
layout_mode = 2
unique_name_in_owner = true
size_flags_horizontal = 3
text = "leaders"
icon = ExtResource("7")

[node name="Share" type="Button" parent="VBox/Buttons"]
layout_mode = 2
unique_name_in_owner = true
size_flags_horizontal = 3
text = "ch_share"
icon = ExtResource("5")

[node name="Menu" type="Button" parent="VBox/Buttons"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"IconButton"
custom_minimum_size = Vector2(52, 52)
tooltip_text = "menu"
icon = ExtResource("8")
icon_alignment = 1

[connection signal="pressed" from="VBox/RewardRow/Double" to="." method="_on_double_pressed"]
[connection signal="pressed" from="VBox/Continue" to="." method="_on_continue_pressed"]
[connection signal="pressed" from="VBox/Shuffle" to="." method="_on_shuffle_pressed"]
[connection signal="pressed" from="VBox/Again" to="." method="_on_again_pressed"]
[connection signal="pressed" from="VBox/Buttons/Leaders" to="." method="_on_leaders_pressed"]
[connection signal="pressed" from="VBox/Buttons/Share" to="." method="_on_share_pressed"]
[connection signal="pressed" from="VBox/Buttons/Menu" to="." method="_on_menu_pressed"]
